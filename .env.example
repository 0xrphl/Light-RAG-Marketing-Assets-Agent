# Media Assets Marketing Agent — Environment Configuration
# Copy this file to .env and fill in your API keys

# ── LightRAG Server ──────────────────────────────────────────────────────
LIGHTRAG_URL=http://localhost:9621

# ── API Keys ─────────────────────────────────────────────────────────────
# OpenAI (used by LightRAG for entity extraction + embeddings)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE

# Anthropic (optional — for advanced querying agents)
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE
ANTHROPIC_MODEL=claude-sonnet-4-6

# Gemini (used for image vision analysis)
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash

# ── LightRAG Models ─────────────────────────────────────────────────────
LLM_BINDING=openai
LLM_MODEL=gpt-4o
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-small

# ── Neo4j ────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=lightrag2026

# ── Images Directory ─────────────────────────────────────────────────────
IMAGES_DIR=./imgs
